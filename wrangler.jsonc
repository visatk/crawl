{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "crawl",
	"main": "worker/index.ts",
	"compatibility_date": "2026-05-30",
	"assets": {
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"placement": {
    "mode": "smart"
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "<BINDING_ID>"
    },
    {
      "binding": "JOB_HISTORY",
      "id": "dummy-kv-id"
    }
  ]
}